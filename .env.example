# make dev uses .key and bifrost_test, with no .env required.
BIFROST_KEY_FILE=.key
# Required by make deploy. Use the browser-facing HTTPS origin.
BIFROST_PUBLIC_ORIGIN=https://bifrost.example.com
# Reverse proxy on the same host forwards to this loopback port.
BIFROST_HTTP_PORT=8080
# Optional: existing deployment master key (retain when upgrading an existing workspace).
# MASTER_KEY_FILE=/secure/bifrost/master-key
