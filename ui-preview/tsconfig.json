{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "types": ["vite/client"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "antd": ["./node_modules/antd"],
      "echarts": ["./node_modules/echarts"],
      "echarts/*": ["./node_modules/echarts/*"]
    }
  },
  "include": ["src"]
}
